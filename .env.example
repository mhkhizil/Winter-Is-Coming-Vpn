# ---------------------------------------------------------------------------
# vpn - local development environment. Copy to .env and adjust.
# Never commit .env. CI injects these values from the environment instead.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
VPN_ENV=development                 # development | staging | production
VPN_LOG_LEVEL=debug                 # trace | debug | info | warn | error
VPN_HTTP_BIND=127.0.0.1:8080        # control-plane REST listener
VPN_GRPC_BIND=127.0.0.1:9090        # control-plane gRPC listener (M3+)
VPN_METRICS_BIND=127.0.0.1:9100     # /metrics, /healthz, /readyz
VPN_ADMIN_TOKEN=dev-only-change-me   # dev bootstrap token; ignored unless VPN_DEV_MODE=true
VPN_DEV_MODE=true                   # enables /debug endpoints + fixed dev tokens

# --- data plane (M2+) ------------------------------------------------------
VPN_DP_BIND=0.0.0.0:51820           # WireGuard UDP listener
VPN_DP_TUN=wg-tenant-0
VPN_DP_MTU=1420

# --- database --------------------------------------------------------------
VPN_DATABASE_URL=postgres://vpn:vpn@127.0.0.1:5432/vpn?sslmode=disable
VPN_DB_POOL_SIZE=10
VPN_REDIS_URL=redis://127.0.0.1:6379/0

# --- auth ------------------------------------------------------------------
VPN_JWT_ISSUER=https://api.vpn.local
VPN_JWT_AUDIENCE=vpn-api
VPN_ACCESS_TOKEN_TTL_SECS=600
VPN_REFRESH_TOKEN_TTL_SECS=2592000
# openssl rand -base64 48
VPN_JWT_SIGNING_KEY=
VPN_PASSWORD_PEPPER=dev-pepper-not-for-production

# --- billing (M4+) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vpnd
# TLS is terminated by the edge proxy (ADR-0009). In production both of these are
# required: vpnd refuses to start without them.
VPN_TLS_TERMINATED_BY_PROXY=true
VPN_TLS_REQUIRE_HTTPS=true
# Optional: emit HSTS on requests the proxy marked as https.
VPN_TLS_HSTS=true
# CIDRs whose X-Forwarded-Proto is believed. Never a wildcard.
VPN_TLS_TRUSTED_PROXIES=127.0.0.1/32

# vpnctl (server/cli): default base URL and token file.
VPN_API=http://127.0.0.1:8080
VPN_TOKEN_FILE=
