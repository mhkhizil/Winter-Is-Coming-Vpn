# vpn-datad - WireGuard data plane (M2+).
#
# Hardening notes for operators (verify with `systemd-analyze security vpn-datad`,
# target exposure < 2.0):
#   * the process needs CAP_NET_ADMIN + CAP_NET_RAW and /dev/net/tun, nothing else
#   * it never touches a database, a TLS socket or the JSON parser
#   * it drops to the `vpn` user after configuring the interface, so a compromise
#     of the packet path does not yield root
[Unit]
Description=vpn data plane (WireGuard-compatible tunnel terminator)
Documentation=https://example.invalid/vpn/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target
# Never give up restarting: a downed tunnel is a customer-visible outage.
StartLimitIntervalSec=0

[Service]
Type=simple
NotifyAccess=main
ExecStart=/usr/bin/vpn-datad --config /etc/vpn/datad.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2s
TimeoutStopSec=30s

User=vpn
Group=vpn
RuntimeDirectory=vpn
RuntimeDirectoryMode=0750
StateDirectory=vpn
LogsDirectory=vpn

# --- capabilities ------------------------------------------------------------
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
SecureBits=keep-caps

# --- filesystem --------------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no          # /dev/net/tun is required
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/run/vpn /var/lib/vpn /var/log/vpn
ReadOnlyPaths=/etc/vpn

# --- kernel surface ----------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @obsolete
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

# --- resource limits ---------------------------------------------------------
LimitNOFILE=1048576
LimitMEMLOCK=infinity        # mlockall() for the worker threads
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
