# vpnd - control plane image.
#
# Two stages: a pinned Debian build image with just enough to compile, and a
# distroless runtime with no shell, no package manager and a non-root user.
# The M0 build needs no external dependencies at all, which is why this builds
# offline in CI.

ARG DEBIAN_VERSION=bookworm

# --- builder -----------------------------------------------------------------
# Uses the distribution's CMake on purpose: no network fetch at build time beyond
# apt, which keeps CI reliable and the image reproducible.
FROM debian:${DEBIAN_VERSION}-slim AS builder

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential gcc g++ ninja-build cmake ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt CMakePresets.json ./
COPY cmake ./cmake
COPY server ./server

RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DVPN_WARNINGS_AS_ERRORS=ON \
      -DVPN_BUILD_TESTS=ON \
 && cmake --build build --parallel "$(nproc)" \
 && ctest --test-dir build --output-on-failure \
 && strip build/server/vpnd

# vpnd keeps its control-plane state in a file; the distroless runtime has no
# shell, so the directory is created and chowned here and copied in.
RUN mkdir -p /var/lib/vpn && chown 65532:65532 /var/lib/vpn

# --- runtime -----------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

COPY --from=builder /src/build/server/vpnd /usr/local/bin/vpnd
COPY --from=builder --chown=65532:65532 /var/lib/vpn /var/lib/vpn

ENV VPN_STORE_PATH=/var/lib/vpn/control.log
WORKDIR /var/lib/vpn
USER 65532:65532
EXPOSE 8080 9100
ENTRYPOINT ["/usr/local/bin/vpnd"]
CMD ["--bind", "0.0.0.0:8080", "--metrics-bind", "0.0.0.0:9100"]
